# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealsdb

# Secret used to sign the session cookie (any long random string).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Generate one with browser: "console.log(Array.from(crypto.getRandomValues(new Uint8Array(32)), b => b.toString(16).padStart(2, '0')).join(''))"
SESSION_SECRET=change-me-to-a-long-random-string
